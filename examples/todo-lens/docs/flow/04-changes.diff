+/** 按标签筛选；tag 为 undefined 表示"全部"（P-6，AC-2） */
+export function filterByTag(items: readonly TodoItem[], tag: string | undefined): TodoItem[] {
+  return tag === undefined ? [...items] : items.filter(i => i.tag === tag);
